{
  "name": "discord-management-mcp",
  "version": "0.1.1",
  "type": "module",
  "description": "Safe-by-default Discord management MCP server with JSON backups, restore planning, and guarded mutations.",
  "license": "MIT",
  "author": {
    "name": "Michael Gasperini",
    "url": "https://mikesoft.it"
  },
  "homepage": "https://github.com/TheStreamCode/discord-management-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheStreamCode/discord-management-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/TheStreamCode/discord-management-mcp/issues"
  },
  "funding": "https://github.com/sponsors/TheStreamCode",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "discord",
    "discord-management",
    "discord-bot",
    "backup",
    "rollback"
  ],
  "bin": {
    "discord-management-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "docs/configuration.md",
    "docs/design.md",
    "docs/safety-and-backups.md",
    "docs/tools.md",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "SECURITY.md",
    "CONTRIBUTING.md",
    ".env.example"
  ],
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.5.1"
  },
  "packageManager": "npm@11.16.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "clean": "node -e \"import('node:fs').then(fs=>fs.rmSync('dist',{recursive:true,force:true}))\"",
    "prebuild": "npm run clean",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "lint": "eslint .",
    "test": "node scripts/run-vitest.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run lint && npm run typecheck && npm test",
    "preflight": "npm run check && npm run build",
    "pack:check": "npm pack --dry-run --json",
    "release:check": "node scripts/verify-release.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "discord.js": "^14.27.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "eslint": "^10.8.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
